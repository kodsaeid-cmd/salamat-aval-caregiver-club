DATABASE_URL="file:./dev.db"

# Worker database backend. Production stays on D1 unless explicitly switched to "turso".
DATABASE_BACKEND="d1"
# Store Turso credentials as Cloudflare Worker secrets; never commit real values.
TURSO_DATABASE_URL="libsql://replace-with-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-database-token"

# SMS provider: SMSIR or WEBHOOK
SMS_PROVIDER="SMSIR"
SMS_NOTIFICATIONS_ENABLED="true"

# Store these as Cloudflare Worker secrets in production. Never commit real values.
SMSIR_API_KEY="replace-with-secret"
SMSIR_OTP_TEMPLATE_ID="replace-with-template-id"
SMSIR_OTP_PARAMETER="CODE"

# For caregiver change notifications use either a verify template or a service line.
SMSIR_NOTIFICATION_TEMPLATE_ID="replace-with-template-id"
SMSIR_NOTIFICATION_TITLE_PARAMETER="TITLE"
SMSIR_NOTIFICATION_MESSAGE_PARAMETER="MESSAGE"
SMSIR_LINE_NUMBER="replace-with-service-line"

# Dedicated activation template. Parameters default to STATUS and PASSWORD.
SMSIR_ACTIVATION_TEMPLATE_ID="replace-with-template-id"
SMSIR_ACTIVATION_STATUS_PARAMETER="STATUS"
SMSIR_ACTIVATION_PASSWORD_PARAMETER="PASSWORD"

# Dedicated job-bank reminder template. Parameter defaults to COUNT.
SMSIR_JOB_BANK_TEMPLATE_ID="replace-with-template-id"
SMSIR_JOB_BANK_COUNT_PARAMETER="COUNT"

# Dedicated verify-template for caregiver job/application lifecycle status changes.
SMSIR_JOB_STATUS_TEMPLATE_ID="replace-with-template-id"
SMSIR_JOB_STATUS_JOB_PARAMETER="JOB"
SMSIR_JOB_STATUS_STATUS_PARAMETER="STATUS"

# Optional provider-neutral gateway adapter.
SMS_GATEWAY_URL=""
SMS_GATEWAY_TOKEN=""

# Local development only. Production must keep this false.
OTP_DEBUG="false"
