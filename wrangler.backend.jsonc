{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  // Unified React desktop remains the active outer entrypoint. Referral rewards v5, fixed financial referral data, and first-contract bonus routing are owned directly inside this stable worker.
  // worker/index-desktop-react-v1.ts -> worker/index-caregiver-onboarding-permission-defaults-v2.ts -> worker/index-mobile-reset-v1.ts -> worker/index-unified-financial-v4.ts -> worker/index-referral-rewards.ts -> worker/index-evaluation-benefits-v2.ts -> worker/index-login-intro-media.ts -> worker/index-data-protection.ts -> worker/index-caregiver-platform-v1.ts.
  // /app is an isolated React document for organizational desktop users. /mobile remains isolated React. /panel?classic=1 remains the compatibility escape hatch.
  "main": "./worker/index-desktop-react-v1.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-mobile-react.mjs"
  },
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PARSPACK_S3_ENDPOINT": "https://c576301.parspack.net/c576301",
    "PARSPACK_S3_BUCKET": "c576301",
    "PARSPACK_S3_REGION": "us-east-1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
