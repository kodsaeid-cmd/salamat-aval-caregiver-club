{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  // React mobile owner is the active outer entrypoint. The protected backend chain remains intact:
  // worker/index-mobile-reset-v1.ts -> worker/index-unified-financial-v4.ts -> worker/index-referral-rewards.ts -> worker/index-evaluation-benefits-v2.ts -> worker/index-login-intro-media.ts -> worker/index-data-protection.ts -> worker/index-caregiver-platform-v1.ts -> worker/index-caregiver-click-stability.ts -> worker/index-ui-stability.ts -> worker/index-account-stability.ts -> worker/index-stability.ts.
  // /mobile is isolated from legacy injected mobile runtimes; desktop/classic continues through the protected chain above.
  "main": "./worker/index-mobile-reset-v1.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-mobile-react.mjs"
  },
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PARSPACK_S3_ENDPOINT": "https://c576301.parspack.net/c576301",
    "PARSPACK_S3_BUCKET": "c576301",
    "PARSPACK_S3_REGION": "us-east-1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
