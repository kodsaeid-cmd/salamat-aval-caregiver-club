{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  // Unified React desktop is the active outer entrypoint. Mobile React and the protected backend chain stay intact underneath:
  // worker/index-desktop-react-v1.ts -> worker/index-mobile-reset-v1.ts -> worker/index-unified-financial-v4.ts -> worker/index-referral-rewards.ts -> worker/index-evaluation-benefits-v2.ts -> worker/index-login-intro-media.ts -> worker/index-data-protection.ts -> worker/index-caregiver-platform-v1.ts -> worker/index-caregiver-click-stability.ts -> worker/index-ui-stability.ts -> worker/index-account-stability.ts -> worker/index-stability.ts.
  // /app is an isolated React document for organizational desktop users. /mobile remains isolated React. /panel?classic=1 remains the compatibility escape hatch.
  "main": "./worker/index-desktop-react-v1.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-mobile-react.mjs"
  },
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PARSPACK_S3_ENDPOINT": "https://c576301.parspack.net/c576301",
    "PARSPACK_S3_BUCKET": "c576301",
    "PARSPACK_S3_REGION": "us-east-1",
    "SMSIR_JOB_APPLICATION_CONSULTANT_TEMPLATE_ID": "710677",
    "SMSIR_JOB_APPLICATION_CONSULTANT_NAME_PARAMETER": "CAREGIVER",
    "SMSIR_JOB_APPLICATION_CONSULTANT_MOBILE_PARAMETER": "MOBILE",
    "SMSIR_JOB_APPLICATION_CONSULTANT_JOB_PARAMETER": "JOB"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_BANK_SMS_QUEUE",
        "queue": "salamat-aval-job-bank-sms"
      }
    ],
    "consumers": [
      {
        "queue": "salamat-aval-job-bank-sms",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "retry_delay": 180,
        "max_concurrency": 10
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "5 * * * *",
      "17 2 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}