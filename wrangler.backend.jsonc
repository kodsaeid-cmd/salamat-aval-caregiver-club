{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  // Database backend wrapper keeps D1 as the default and can atomically switch runtime DB calls to Turso without rewriting feature modules.
  // Unified React desktop remains the active application underneath the wrapper. /app is isolated React, /mobile remains isolated React, and /panel?classic=1 is the compatibility escape hatch.
  "main": "./worker/index-database-backend-v1.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-mobile-react.mjs"
  },
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PARSPACK_S3_ENDPOINT": "https://c576301.parspack.net/c576301",
    "PARSPACK_S3_BUCKET": "c576301",
    "PARSPACK_S3_REGION": "us-east-1",
    "SMSIR_JOB_APPLICATION_CONSULTANT_TEMPLATE_ID": "710677",
    "SMSIR_JOB_APPLICATION_CONSULTANT_NAME_PARAMETER": "CAREGIVER",
    "SMSIR_JOB_APPLICATION_CONSULTANT_MOBILE_PARAMETER": "MOBILE",
    "SMSIR_JOB_APPLICATION_CONSULTANT_JOB_PARAMETER": "JOB"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_BANK_SMS_QUEUE",
        "queue": "salamat-aval-job-bank-sms"
      }
    ],
    "consumers": [
      {
        "queue": "salamat-aval-job-bank-sms",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_retries": 8,
        "retry_delay": 180,
        "max_concurrency": 10
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "5 * * * *",
      "17 2 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
