{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  // Job-ad mutation/tombstone policy is the outer production edge, delegating to the unified React desktop owner underneath.
  // worker/index-job-ad-policy-v13.ts -> worker/index-desktop-react-v1.ts -> worker/index-mobile-reset-v1.ts -> protected backend chain.
  // /app is an isolated React document for organizational desktop users. /mobile remains isolated React. /panel?classic=1 remains the compatibility escape hatch.
  "main": "./worker/index-job-ad-policy-v13.ts",
  "compatibility_date": "2026-07-30",
  "keep_vars": true,
  "build": {
    "command": "node scripts/build-mobile-react.mjs"
  },
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PARSPACK_S3_ENDPOINT": "https://c576301.parspack.net/c576301",
    "PARSPACK_S3_BUCKET": "c576301",
    "PARSPACK_S3_REGION": "us-east-1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
