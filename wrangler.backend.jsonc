{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salamat-aval-caregiver-club",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./preview",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salamat-aval-caregiver-club",
      "database_id": "87b39c40-6254-4385-8ed6-77fffeb370da",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
