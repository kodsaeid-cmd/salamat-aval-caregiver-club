{
  "name": "salamat-aval-caregiver-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run preview:build",
    "build:web": "prisma generate && next build && node scripts/fetch-hero.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && node scripts/validate-preview-bundle.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "preview:build": "node scripts/validate-preview-bundle.mjs && node -e \"console.log('Static Cloudflare Workers assets are ready in ./preview')\"",
    "deploy:check": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "wrangler deploy",
    "deploy:workers": "wrangler deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
